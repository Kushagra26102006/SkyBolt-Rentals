# ==============================================================================
# SkyBolt Rentals — Production Frontend Client Container
# High-performance Nginx Alpine image serving optimized static client assets
# ==============================================================================

FROM nginx:alpine

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /etc/nginx/nginx.conf

# Copy custom production Nginx configuration
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/security-headers.conf /etc/nginx/conf.d/security-headers.conf

# Copy static frontend assets (HTML, CSS, JS, Assets)
COPY frontend/ /usr/share/nginx/html/

# Expose HTTP Port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
