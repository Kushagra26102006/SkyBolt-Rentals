# ==============================================================================
# SkyBolt Rentals - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
#
# IMPORTANT SECURITY POLICY:
# - NEVER commit .env files containing sensitive values to version control.
# - NEVER put real passwords, API keys, private keys, or secrets in this file.
# - Keep .env.example tracked in Git with placeholders ONLY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Target environment: 'development' | 'test' | 'production'
APP_ENV=development

# Application base URL (frontend host)
APP_BASE_URL=http://localhost:8080

# API base URL (development placeholder - backend API introduced in Phase 2)
API_BASE_URL=http://localhost:8080/api/v1

# Application version
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Logging level: 'debug' | 'info' | 'warn' | 'error'
# In production, debug logs are suppressed automatically.
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 3. FEATURE FLAGS (Gradual Rollout Controls)
# ------------------------------------------------------------------------------
# Enable or disable features under active development (default: false)
ENABLE_PAYMENTS=false
ENABLE_REVIEWS=false
ENABLE_NOTIFICATIONS=false
ENABLE_AI=true

# ------------------------------------------------------------------------------
# 4. SERVICES PLACEHOLDERS (Documented for Architecture Alignment)
# NOTE: Real credentials must never be committed to repository.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/skybolt_rentals
# JWT_SECRET=your_jwt_secret_minimum_32_characters
# STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# RAZORPAY_KEY_ID=rzp_test_placeholder
# SENDGRID_API_KEY=SG.placeholder
# TWILIO_ACCOUNT_SID=ACplaceholder
# REDIS_URL=redis://127.0.0.1:6379
# AI_RECOMMENDATION_PROVIDER=mock
# AI_RECOMMENDATION_API_KEY=
# AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
