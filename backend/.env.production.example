# ==============================================================================
# SkyBolt Rentals — Production Environment Template (.env.production)
# PRODUCTION ONLY — SECRETS MUST BE INJECTED VIA CI/CD VAULT / AWS SECRETS MANAGER.
# NEVER commit populated production credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production
API_PREFIX=/api/v1

# Security & CORS Settings (Strict production domains - comma separated)
CORS_ORIGIN=https://skyboltrentals.com,https://www.skyboltrentals.com,https://app.skyboltrentals.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# MongoDB Database (PRODUCTION REPLICA SET WITH TLS & LEAST-PRIVILEGE USER)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://skybolt_prod_app:REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD@prod-cluster.skybolt.mongodb.net/skybolt_rentals_prod?retryWrites=true&w=majority&maxPoolSize=50
MONGODB_DB_NAME=skybolt_rentals_prod
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Authentication & Security Configuration
# ------------------------------------------------------------------------------
# Production cryptographically random secret (64+ chars generated via openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_PRODUCTION_CRYPTOGRAPHIC_JWT_SECRET_KEY_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=__Host-skybolt_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_EXPIRES_MS=900000
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (LIVE CREDENTIALS — NEVER SHARE OR EXPOSE)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_ACTUAL_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_ACTUAL_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_ACTUAL_LIVE_WEBHOOK_SECRET_HMAC_SHA256

# ------------------------------------------------------------------------------
# Transactional Email & SMS Notifications Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_live_REPLACE_WITH_VERIFIED_DOMAIN_KEY
EMAIL_PROVIDER_FROM=SkyBolt Rentals <notifications@skyboltrentals.com>

SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=REPLACE_WITH_PRODUCTION_TWILIO_AUTH_TOKEN
SMS_PROVIDER_ACCOUNT_SID=AC_REPLACE_WITH_PRODUCTION_TWILIO_SID
SMS_PROVIDER_SENDER_ID=SKYBOLT

NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=3000
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------------------------
# Redis & Background Queue (PRODUCTION HIGH-AVAILABILITY CLUSTER / SENTINEL)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://:REPLACE_WITH_STRONG_REDIS_AUTH_TOKEN@prod-redis.internal.skybolt.com:6379
REDIS_KEY_PREFIX=skybolt_prod:
REDIS_CONNECT_TIMEOUT_MS=5000
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_ENABLED=true

# ------------------------------------------------------------------------------
# AI Recommendation Engine
# ------------------------------------------------------------------------------
AI_RECOMMENDATION_PROVIDER=openai
AI_RECOMMENDATION_API_KEY=sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY
AI_RECOMMENDATION_MODEL=gpt-4o-mini
AI_RECOMMENDATION_TIMEOUT_MS=2500
AI_RECOMMENDATION_MAX_CANDIDATES=25
AI_RECOMMENDATION_RATE_LIMIT_WINDOW_MS=60000
AI_RECOMMENDATION_RATE_LIMIT_MAX=20
RECOMMENDATION_CACHE_TTL_SECONDS=180
