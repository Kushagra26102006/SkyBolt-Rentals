# ==============================================================================
# SkyBolt Rentals — Staging Environment Template (.env.staging)
# Used for pre-production integration testing, QA verification, and staging smoke tests.
# NEVER commit populated credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=staging
API_PREFIX=/api/v1

# Security & CORS Settings (Staging domains only - no wildcards)
CORS_ORIGIN=https://staging.skyboltrentals.com,https://staging-app.skyboltrentals.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Logging Level
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# MongoDB Database (ISOLATED STAGING CLUSTER — NEVER CONNECT TO PRODUCTION)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://staging_user:STAGING_STRONG_PASSWORD@staging-cluster.skybolt.mongodb.net/skybolt_rentals_staging?retryWrites=true&w=majority
MONGODB_DB_NAME=skybolt_rentals_staging
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# ------------------------------------------------------------------------------
# Authentication & Security Configuration
# ------------------------------------------------------------------------------
# Dedicated staging secret - minimum 32 characters
JWT_SECRET=staging_only_super_secure_jwt_secret_minimum_32_chars_long_123
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=skybolt_auth_staging
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
PASSWORD_RESET_EXPIRES_MS=900000
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (TEST MODE KEYS ONLY FOR STAGING)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_staging_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_staging_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=staging_webhook_secret_hmac_sha256_placeholder

# ------------------------------------------------------------------------------
# Transactional Email & SMS Notifications Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_staging_placeholder_key
EMAIL_PROVIDER_FROM=SkyBolt Staging <notifications@staging.skyboltrentals.com>

SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=mock_or_staging_auth_token
SMS_PROVIDER_ACCOUNT_SID=ACstaging_placeholder_sid
SMS_PROVIDER_SENDER_ID=SKYBOLT

NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------------------------
# Redis & Background Queue (ISOLATED STAGING INSTANCE)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:STAGING_REDIS_PASSWORD@staging-redis.skybolt.internal:6379
REDIS_KEY_PREFIX=skybolt_staging:
REDIS_CONNECT_TIMEOUT_MS=5000
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_ENABLED=true

# ------------------------------------------------------------------------------
# AI Recommendation Engine
# ------------------------------------------------------------------------------
AI_RECOMMENDATION_PROVIDER=openai
AI_RECOMMENDATION_API_KEY=sk-proj-staging-placeholder-key
AI_RECOMMENDATION_MODEL=gpt-4o-mini
AI_RECOMMENDATION_TIMEOUT_MS=2500
AI_RECOMMENDATION_MAX_CANDIDATES=25
AI_RECOMMENDATION_RATE_LIMIT_WINDOW_MS=60000
AI_RECOMMENDATION_RATE_LIMIT_MAX=20
RECOMMENDATION_CACHE_TTL_SECONDS=180
