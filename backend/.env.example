# ==============================================================================
# SkyBolt Rentals - Backend Environment Template
# Copy to .env or .env.local for local backend execution.
# NEVER commit real credentials to Git.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS Settings (Comma-separated allowed origins)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug

# Request Body Limit
REQUEST_BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Local development connection string (Default for local MongoDB)
MONGODB_URI=mongodb://localhost:27017/skybolt_rentals
MONGODB_DB_NAME=skybolt_rentals

# Operational Connection Options
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# For MongoDB Atlas Deployments (Example pattern - DO NOT commit real passwords):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skybolt_rentals?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication & Security Configuration (TASK 05)
# ------------------------------------------------------------------------------
# Minimum 32-character secret string (Placeholders only - NEVER commit production secrets)
JWT_SECRET=development_super_secure_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Session Cookie Configuration
AUTH_COOKIE_NAME=skybolt_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Security Rate Limiting & Expirations
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
PASSWORD_RESET_EXPIRES_MS=900000
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration (TASK 10)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# ------------------------------------------------------------------------------
# Transactional Email & SMS Notifications Configuration (TASK 13)
# ------------------------------------------------------------------------------
# Email Provider: 'mock' | 'standard' | 'resend' | 'sendgrid'
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_FROM=SkyBolt Rentals <notifications@skyboltrentals.com>

# SMS Provider: 'mock' | 'standard' | 'twilio'
SMS_PROVIDER=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_SENDER_ID=SKYBOLT

# Outbox Worker & Resilience
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------------------------
# Redis & Background Queue Configuration (TASK 15)
# ------------------------------------------------------------------------------
# Centralized Redis connection URL (Preferred for cloud providers: Render, Railway, Upstash, Redis Cloud)
REDIS_URL=redis://127.0.0.1:6379

# Discrete host/port fallback if REDIS_URL is not set
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=skybolt:
REDIS_CONNECT_TIMEOUT_MS=5000

# Cache-Aside controls
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# BullMQ Background Worker controls
QUEUE_ENABLED=true

# ------------------------------------------------------------------------------
# AI-Powered Vehicle Recommendation Engine (TASK 16)
# ------------------------------------------------------------------------------
# Provider: 'mock' (default offline heuristic AI) | 'openai' | 'gemini' | 'anthropic' | 'disabled'
AI_RECOMMENDATION_PROVIDER=mock
AI_RECOMMENDATION_API_KEY=
AI_RECOMMENDATION_MODEL=gpt-4o-mini
AI_RECOMMENDATION_TIMEOUT_MS=2500
AI_RECOMMENDATION_MAX_CANDIDATES=25
AI_RECOMMENDATION_RATE_LIMIT_WINDOW_MS=60000
AI_RECOMMENDATION_RATE_LIMIT_MAX=20
RECOMMENDATION_CACHE_TTL_SECONDS=180

# ------------------------------------------------------------------------------
# Production AI Chatbot — SkyBolt AI Integration
# ------------------------------------------------------------------------------
# Provider: 'mock' (offline deterministic provider for CI/dev) | 'openai' | 'gemini'
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_TOOL_CALLS=5
AI_MAX_MESSAGE_LENGTH=2000
CHAT_RATE_LIMIT_GUEST=10
CHAT_RATE_LIMIT_AUTH=30
